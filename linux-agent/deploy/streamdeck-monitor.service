[Unit]
Description=NodeDeck Linux monitoring agent
After=network-online.target

[Service]
ExecStart=/usr/local/bin/node-deck-agent -config /etc/streamdeck-monitor/config.yaml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
