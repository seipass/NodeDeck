{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.nodedeck.monitor",
  "Name": "NodeDeck Monitor",
  "Version": "0.1.0.0",
  "Author": "NodeDeck",
  "Description": "Display Linux CPU and memory metrics.",
  "Icon": "imgs/metric-display",
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Category": "NodeDeck Monitor",
  "Software": {
    "MinimumVersion": "7.1"
  },
  "SDKVersion": 2,
  "CodePath": "plugin.js",
  "Nodejs": {
    "Version": "24"
  },
  "Actions": [
    {
      "Name": "Metric Display",
      "UUID": "com.nodedeck.monitor.metric-display",
      "Icon": "imgs/metric-display",
      "States": [
        {
          "Image": "imgs/metric-display"
        }
      ],
      "Tooltip": "Display a Linux metric",
      "PropertyInspectorPath": "ui/metric-display.html"
    }
  ]
}